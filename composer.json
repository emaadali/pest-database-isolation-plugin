{
    "name": "emaadali/pest-neondb-plugin",
    "description": "Pest plugin for isolating Laravel parallel and concurrent test runs with Neon branches or local Postgres databases.",
    "keywords": [
        "php",
        "framework",
        "pest",
        "unit",
        "test",
        "testing",
        "plugin"
    ],
    "license": "MIT",
    "require": {
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/testing": "^11.0|^12.0|^13.0",
        "php": "^8.3",
        "pestphp/pest": "^4.4.3",
        "pestphp/pest-plugin": "^4.0.0"
    },
    "autoload": {
        "psr-4": {
            "Emaadali\\PestDatabaseIsolation\\": "src/"
        },
        "files": [
            "src/Autoload.php"
        ]
    },
    "bin": [
        "bin/setup-worktree-database"
    ],
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest-dev-tools": "^4.1.0"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "preferred-install": "dist",
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "refacto": "rector",
        "lint": "pint",
        "test:refacto": "rector --dry-run",
        "test:lint": "pint --test",
        "test:types": "phpstan analyse --ansi",
        "test:unit": "pest --colors=always",
        "test": [
            "@test:refacto",
            "@test:lint",
            "@test:types",
            "@test:unit"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Emaadali\\PestDatabaseIsolation\\TestingDatabaseServiceProvider"
            ]
        }
    }
}
